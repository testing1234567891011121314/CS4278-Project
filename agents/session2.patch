+        candidates = self.sample_antipodal_grasps(points=obs['object_pc'], normals=obs['object_normals'],
+                                                  com=obs['object_pos'])
         stats['candidates'] = len(candidates)
         if not candidates:
             stats['reason'] = 'no_antipodal_pairs'
